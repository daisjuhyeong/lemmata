{
  "name": "lemmata",
  "displayName": "Lemmata",
  "description": "Lemmata in your editor: the experiment bench. Your runs, each experiment with its setup, and what to run next, in VS Code's own lists. Everything else is on the Lemmata website.",
  "version": "0.8.0",
  "publisher": "lemmata-local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lemmata-local/lemmata.git"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "Lemmata",
      "properties": {
        "lemmata.serverUrl": {
          "type": "string",
          "scope": "application",
          "default": "http://100.111.135.94:8765",
          "markdownDescription": "Address of your Lemmata hub (http or https). Machine-wide only: a repo's .vscode/settings.json cannot change it. The token is kept in VS Code's secret storage, never in settings."
        },
        "lemmata.project": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "markdownDescription": "Hub project id to use for this workspace. Leave empty to match the workspace's git remotes against your hub projects."
        },
        "lemmata.refreshSeconds": {
          "type": "number",
          "scope": "application",
          "default": 30,
          "minimum": 10,
          "description": "How often, in seconds, to read the experiments and what to run next from the hub while this window is in front (also when the window gets focus and when a run is sent)."
        },
        "lemmata.runs.capture": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "markdownDescription": "Log experiments run in the integrated terminal and result files that appear in the results folders into `.lemmata/runs/` (git-ignored), and send those run records to your hub. Only the command, commit, hashes, numbers and file paths are recorded: never code, data or weights."
        },
        "lemmata.runs.commandPattern": {
          "type": "string",
          "scope": "window",
          "default": "",
          "markdownDescription": "Regular expression for the commands that count as experiments. Empty uses the built-in pattern (python, accelerate launch, torchrun, sbatch, srun, `bash x.sh`, `./x.sh`, optionally behind `uv run`, env assignments or `nohup`)."
        },
        "lemmata.runs.resultFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "window",
          "default": [],
          "markdownDescription": "Globs (relative to the repository) of the folders your runs write results to. Empty uses `results/**`, `outputs/**`, `output/**`, `runs/**`, `logs/**`, `experiments/**`, `exp/**`, `checkpoints/**`."
        },
        "lemmata.runs.metricFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "window",
          "default": [],
          "markdownDescription": "File-name globs of metrics files inside those folders. Empty uses `*metric*`, `*result*`, `*score*`, `*eval*` as `.json`/`.csv`, `summary.json` and `*metric*.jsonl`."
        }
      }
    },
    "commands": [
      {
        "command": "lemmata.connect",
        "title": "Connect to Server",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.goto",
        "title": "Go to…",
        "category": "Lemmata",
        "icon": "$(compass)"
      },
      {
        "command": "lemmata.refresh",
        "title": "Refresh",
        "category": "Lemmata",
        "icon": "$(refresh)"
      },
      {
        "command": "lemmata.runs.sync",
        "title": "Send Runs to the Hub Now",
        "category": "Lemmata",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "lemmata.setupAgent",
        "title": "Set Up Coding Agent (Claude Code)",
        "category": "Lemmata",
        "icon": "$(hubot)"
      },
      {
        "command": "lemmata.addProject",
        "title": "Add This Repository",
        "category": "Lemmata",
        "icon": "$(add)"
      },
      {
        "command": "lemmata.openMap",
        "title": "Open the Map (large)",
        "category": "Lemmata",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "lemmata.disconnect",
        "title": "Disconnect (forget token)",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.showPanel",
        "title": "Show the Lists",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.openSetup",
        "title": "Open Setup",
        "category": "Lemmata",
        "icon": "$(table)"
      },
      {
        "command": "lemmata.openWebsite",
        "title": "Open the Website",
        "category": "Lemmata",
        "icon": "$(link-external)"
      },
      {
        "command": "lemmata.row.record",
        "title": "Open the Run Record",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.row.open",
        "title": "Open the File",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.row.tab",
        "title": "Open in Setup",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.row.site",
        "title": "Open on the Website",
        "category": "Lemmata",
        "icon": "$(link-external)"
      },
      {
        "command": "lemmata.row.copy",
        "title": "Copy (prompt or command)",
        "category": "Lemmata",
        "icon": "$(copy)"
      },
      {
        "command": "lemmata.row.snooze",
        "title": "Snooze…",
        "category": "Lemmata"
      },
      {
        "command": "lemmata.run.attach",
        "title": "Attach to an Experiment…",
        "category": "Lemmata"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lemmata",
          "title": "Lemmata",
          "icon": "media/lemmata.svg"
        }
      ]
    },
    "views": {
      "lemmata": [
        {
          "id": "lemmata.now",
          "name": "Now",
          "contextualTitle": "Lemmata"
        },
        {
          "id": "lemmata.experiments",
          "name": "Experiments",
          "contextualTitle": "Lemmata"
        },
        {
          "id": "lemmata.torun",
          "name": "To run",
          "contextualTitle": "Lemmata",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lemmata.now",
        "contents": "Not connected to a Lemmata server yet.\n[Connect to Server](command:lemmata.connect)",
        "when": "!lemmata.connected && !lemmata.hasRuns"
      },
      {
        "view": "lemmata.now",
        "contents": "No runs logged yet.\nRun an experiment in the integrated terminal (for example `python train.py`) and it appears here with its commit, its numbers and the experiment it belongs to. Jobs started elsewhere (tmux, sbatch) are picked up when they write a metrics file into a results folder.\n[Set up the coding agent](command:lemmata.setupAgent)",
        "when": "lemmata.connected && !lemmata.hasRuns"
      },
      {
        "view": "lemmata.experiments",
        "contents": "Not connected to a Lemmata server yet.\n[Connect to Server](command:lemmata.connect)",
        "when": "!lemmata.connected"
      },
      {
        "view": "lemmata.experiments",
        "contents": "No Lemmata project matches this folder.\n[Add This Repository](command:lemmata.addProject)",
        "when": "lemmata.connected && !lemmata.hasProject"
      },
      {
        "view": "lemmata.experiments",
        "contents": "No experiments yet. Lemmata lists them once the project map is confirmed on the website.\n[Open the website](command:lemmata.openWebsite)",
        "when": "lemmata.connected && lemmata.hasProject && !lemmata.hasExperiments"
      },
      {
        "view": "lemmata.torun",
        "contents": "Nothing to run next.\nPlanned experiments, results that are older than their code and results with a single run appear here.",
        "when": "lemmata.connected && lemmata.hasProject && !lemmata.hasToRun"
      },
      {
        "view": "lemmata.torun",
        "contents": "Connect and open a project to see what to run next.\n[Go to…](command:lemmata.goto)",
        "when": "!lemmata.connected || !lemmata.hasProject"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lemmata.runs.sync",
          "when": "view == lemmata.now",
          "group": "navigation@1"
        },
        {
          "command": "lemmata.refresh",
          "when": "view == lemmata.now",
          "group": "navigation@2"
        },
        {
          "command": "lemmata.goto",
          "when": "view == lemmata.now",
          "group": "navigation@3"
        },
        {
          "command": "lemmata.openMap",
          "when": "view == lemmata.experiments",
          "group": "navigation@1"
        },
        {
          "command": "lemmata.openSetup",
          "when": "view == lemmata.experiments",
          "group": "navigation@2"
        },
        {
          "command": "lemmata.refresh",
          "when": "view == lemmata.experiments",
          "group": "navigation@3"
        },
        {
          "command": "lemmata.refresh",
          "when": "view == lemmata.torun",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "lemmata.row.copy",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-copy/",
          "group": "inline@1"
        },
        {
          "command": "lemmata.row.site",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-site/",
          "group": "inline@2"
        },
        {
          "command": "lemmata.row.record",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-record/",
          "group": "1_open@1"
        },
        {
          "command": "lemmata.row.open",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-open/",
          "group": "1_open@2"
        },
        {
          "command": "lemmata.row.tab",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-tab/",
          "group": "1_open@3"
        },
        {
          "command": "lemmata.row.site",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-site/",
          "group": "1_open@4"
        },
        {
          "command": "lemmata.run.attach",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-attach/",
          "group": "2_do@1"
        },
        {
          "command": "lemmata.row.copy",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-copy/",
          "group": "2_do@2"
        },
        {
          "command": "lemmata.row.snooze",
          "when": "view =~ /^lemmata\\./ && viewItem =~ /-snooze/",
          "group": "2_do@3"
        }
      ],
      "commandPalette": [
        {
          "command": "lemmata.showPanel",
          "when": "false"
        },
        {
          "command": "lemmata.openSetup",
          "when": "false"
        },
        {
          "command": "lemmata.openWebsite",
          "when": "false"
        },
        {
          "command": "lemmata.row.record",
          "when": "false"
        },
        {
          "command": "lemmata.row.open",
          "when": "false"
        },
        {
          "command": "lemmata.row.tab",
          "when": "false"
        },
        {
          "command": "lemmata.row.site",
          "when": "false"
        },
        {
          "command": "lemmata.row.copy",
          "when": "false"
        },
        {
          "command": "lemmata.row.snooze",
          "when": "false"
        },
        {
          "command": "lemmata.run.attach",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/unit/*.test.js\"",
    "test:integration": "npm run compile && node --test --test-timeout=240000 \"out/test/integration/*.test.js\"",
    "test:host": "npm run compile && node out/test/host/run.js",
    "package": "npx @vscode/vsce package",
    "test:e2e": "npm run compile && node --test --test-timeout=240000 \"out/test/e2e/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "extensionKind": [
    "workspace"
  ]
}
